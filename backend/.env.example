# Database configuration
# PostgreSQL asyncpg connection string placeholder
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/task_manager_db

# Application settings
APP_NAME="Task Manager API"
APP_ENV=development
DEBUG=True
API_V1_PREFIX=
DB_ECHO=False

# JWT & Authentication Configuration
JWT_SECRET_KEY=your-super-secret-jwt-key-replace-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Origins (comma-separated list for frontend clients)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174,http://localhost:5175

# Task Reminders
TASK_DUE_SOON_HOURS=24

