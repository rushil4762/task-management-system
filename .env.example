# Database configuration
# PostgreSQL asyncpg connection string placeholder
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/task_manager_db

# Application settings
APP_NAME="Task Manager API"
APP_ENV=development
DEBUG=True
API_V1_PREFIX=/api/v1
DB_ECHO=False

# CORS Origins (comma-separated list for frontend clients)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
